# Export these in your shell for a production deployment.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=your-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
AWS_STORAGE_BUCKET_NAME=private-bucket-name
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
AWS_S3_REGION_NAME=your-region
# Optional for an S3-compatible provider such as Cloudflare R2:
# AWS_S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
